{
  "name": "@polaris/twin-geometry",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Digital Twin geometry + scene pipeline for Cesium (real public data only)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "echo ok",
    "test": "echo ok",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@polaris/connector-sdk": "workspace:*",
    "@polaris/domain": "workspace:*",
    "@polaris/spatial": "workspace:*",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.10.2",
    "@types/pngjs": "^6.0.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
