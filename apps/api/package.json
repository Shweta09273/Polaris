{
  "name": "@polaris/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo \"ok\"",
    "test": "tsx --test src/**/*.test.ts",
    "db:migrate": "echo \"Migrations land in Milestone 2 — schemas bootstrapped via docker init SQL\"",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@polaris/compiler": "workspace:*",
    "@polaris/contracts": "workspace:*",
    "@polaris/decision-engine": "workspace:*",
    "@polaris/domain": "workspace:*",
    "@polaris/experiment-engine": "workspace:*",
    "@polaris/runtime": "workspace:*",
    "@polaris/simulation": "workspace:*",
    "@polaris/twin-geometry": "workspace:*",
    "@polaris/twin-registry": "workspace:*",
    "fastify": "^5.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
