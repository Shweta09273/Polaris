{
  "name": "@polaris/package",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Official .polaris package format — PLRS envelope, pack/unpack, verify",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/pack.test.ts",
    "lint": "echo ok",
    "clean": "rimraf dist",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "dependencies": {
    "@polaris/ontology": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
