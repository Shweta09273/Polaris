{
  "name": "@polaris/ontology",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "POLARIS Urban Ontology — semantic single source of truth",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo \"ok\"",
    "test": "tsx --test src/integrity.test.ts",
    "clean": "rimraf dist",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
