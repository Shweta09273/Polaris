{
  "name": "polaris",
  "private": true,
  "version": "0.1.0",
  "description": "POLARIS — AI Decision Intelligence Platform (Living Digital Twin)",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@polaris/api --filter=@polaris/web",
    "dev:all": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "infra:up": "docker compose -f infrastructure/docker/docker-compose.yml --env-file .env up -d",
    "infra:down": "docker compose -f infrastructure/docker/docker-compose.yml --env-file .env down",
    "infra:logs": "docker compose -f infrastructure/docker/docker-compose.yml --env-file .env logs -f --tail=200",
    "infra:ps": "docker compose -f infrastructure/docker/docker-compose.yml --env-file .env ps",
    "db:migrate": "pnpm --filter @polaris/api db:migrate",
    "bootstrap:city": "pnpm --filter @polaris/bootstrap exec node --import tsx src/cli-entry.ts bootstrap city",
    "compile:city": "pnpm --filter @polaris/compiler exec node --import tsx src/cli-entry.ts city",
    "twin3d:city": "pnpm --filter @polaris/twin-geometry exec tsx src/cli.ts",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yml,yaml}\"",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
