# POLARIS local environment — NEVER commit real secrets
# Copy to .env and customize

COMPOSE_PROJECT_NAME=polaris

# --- Postgres / PostGIS (spatial) ---
POSTGIS_USER=polaris
POSTGIS_PASSWORD=polaris_dev_change_me
POSTGIS_DB=polaris_spatial
POSTGIS_PORT=5432

# --- TimescaleDB ---
TIMESCALE_USER=polaris
TIMESCALE_PASSWORD=polaris_dev_change_me
TIMESCALE_DB=polaris_ts
TIMESCALE_PORT=5433

# --- Neo4j ---
NEO4J_USER=neo4j
NEO4J_PASSWORD=polaris_dev_change_me
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# --- Redis ---
REDIS_PORT=6379

# --- NATS ---
NATS_PORT=4222
NATS_MONITOR_PORT=8222

# --- MinIO ---
MINIO_ROOT_USER=polarisminio
MINIO_ROOT_PASSWORD=polaris_dev_change_me
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Keycloak ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=polaris_dev_change_me
KEYCLOAK_PORT=8080

# --- OpenSearch ---
OPENSEARCH_PORT=9200

# --- Observability ---
GRAFANA_PORT=3001
PROMETHEUS_PORT=9090

# --- Apps ---
WEB_PORT=3000
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_PUBLIC_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
OIDC_ISSUER=http://localhost:8080/realms/polaris

# --- External APIs (leave empty until provisioned) ---
OPEN_METEO_API_KEY=
WAQI_API_TOKEN=
COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=
COPERNICUS_S3_ACCESS_KEY=
COPERNICUS_S3_SECRET_KEY=

# --- Feature flags ---
FEATURE_SIMULATION=false
FEATURE_DECISION_ENGINE=true

# --- Milestone 3: Package signing / Runtime ---
# HMAC secret for .polaris package signatures (required in production)
POLARIS_PACKAGE_HMAC_SECRET=
# Allow unsigned packages in local/dev (default true). Set false in production.
POLARIS_ALLOW_UNSIGNED_PACKAGES=true

# --- Web → API ---
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Cesium (optional Ion token for world terrain / Bing; OSM tiles work without it) ---
NEXT_PUBLIC_CESIUM_ION_TOKEN=
